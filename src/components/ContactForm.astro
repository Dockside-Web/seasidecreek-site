---
//Update this variable with your actual Basin form ID for the form to work correctly.
const basinURL = "https://usebasin.com/f/55bd10f9f2d4";

//Update this variable with your actual Cloudflare Turnstile site key for the widget to work correctly.
//The Turnstile script is loaded at the bottom of this component, so it only loads on pages with the form.
const turnstileSiteKey = "0x4AAAAAAC5fyomFByLo3Gjo";
---

<div class="w-full max-w-2xl rounded-2xl border border-gray-100 bg-white p-4 sm:p-8 shadow-sm mb-2">
  <form id="contact-form" action={basinURL} method="POST" class="space-y-5">
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <label for="name" class="mb-1 block text-sm font-medium text-gray-700">
          Full Name <span class="text-red-600" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          placeholder="John Doe"
          required
          class="contact-input focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 w-full rounded-lg border border-gray-300 px-4 py-2 transition-all outline-none"
        />
      </div>

      <div>
        <label for="company" class="mb-1 block text-sm font-medium text-gray-700">
          Company (optional)
        </label>
        <input
          type="text"
          id="company"
          name="company"
          autocomplete="organization"
          placeholder="Company Name, LLC"
          class="contact-input focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 w-full rounded-lg border border-gray-300 px-4 py-2 transition-all outline-none"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div>
        <label for="email" class="mb-1 block text-sm font-medium text-gray-700">
          Email Address <span class="text-red-600" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          placeholder="you@example.com"
          required
          class="contact-input focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 w-full rounded-lg border border-gray-300 px-4 py-2 transition-all outline-none"
        />
      </div>

      <div>
        <label for="phone" class="mb-1 block text-sm font-medium text-gray-700">
          Phone Number
        </label>
        <input
          type="tel"
          id="phone"
          name="phone"
          autocomplete="tel"
          placeholder="(555) 000-0000"
          class="contact-input focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 w-full rounded-lg border border-gray-300 px-4 py-2 transition-all outline-none"
        />
      </div>
    </div>

    <div class="space-y-1"> 
      <label for="message" class="mb-1 block text-sm font-medium text-gray-700">
        Message <span class="text-red-600" aria-hidden="true">*</span>
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        placeholder="How can we help?"
        required
        class="contact-input focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 w-full resize-none rounded-lg border border-gray-300 px-4 py-2 transition-all outline-none"
      ></textarea>
      
      <p class="text-xs text-gray-500 italic leading-snug">
        Fields marked with <span class="text-red-600">*</span> are required.
      </p>
    </div>

    <!-- Cloudflare Turnstile widget -->
    <div
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-callback="turnstileFinished"
      data-theme="light"
    >
    </div>

    <!-- Hidden honeypot field. Needs to have the same name as the one configured in Basin to work correctly. -->
    <div class="absolute top-0 -left-600 h-0 overflow-hidden" aria-hidden="true">
      <label for="_botvortex">Leave this field empty</label>
      <input type="text" id="_botvortex" name="_botvortex" tabindex="-1" autocomplete="off" />
    </div>

    <button
      type="submit"
      id="submit-btn"
      disabled
      class="w-full rounded-lg bg-brand-primary px-6 py-3 font-semibold text-white cursor-pointer shadow-md transition-all duration-200 hover:bg-brand-primary-light hover:shadow-lg active:scale-[0.98] active:transform disabled:cursor-not-allowed disabled:bg-gray-300 disabled:shadow-none"
    >
      Send Message
    </button>
  </form>
</div>

<script>
  declare global {
    interface Window {
      turnstileFinished?: () => void;
    }
  }

  let isTurnstileVerified = false;
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const requiredInputs = form.querySelectorAll("[required]") as NodeListOf<
    HTMLInputElement | HTMLTextAreaElement
  >;

  // Function called by Cloudflare when check is passed
  window.turnstileFinished = function () {
    isTurnstileVerified = true;
    checkFormValidity();
  };

  const checkFormValidity = () => {
    // Check if all required fields have values
    const allFieldsFilled = Array.from(requiredInputs).every((input) => input.value.trim() !== "");

    // Only enable if fields are filled AND turnstile is verified
    submitBtn.disabled = !(allFieldsFilled && isTurnstileVerified);
  };

  // Add event listeners to all required inputs
  requiredInputs.forEach((input) => {
    input.addEventListener("input", checkFormValidity);
  });
</script>

<!-- Cloudflare Turnstile (only loaded on pages that include the form) -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
