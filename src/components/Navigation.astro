---
import { Image } from "astro:assets";
import logoWhiteHorizontal from "../assets/logoWhiteHorizontal.svg";
import Button from "./Button.astro";
import { contactInfo } from "../data/info.ts";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/#about" }
];

const currentPath = Astro.url.pathname;
---

<!-- data-scrolled is toggled by the script below; all scrolled styles key off it -->
<header
  id="site-header"
  class="group/header fixed top-0 left-0 right-0 z-50 py-5 border-b border-transparent transition-all duration-500 data-scrolled:py-3 data-scrolled:bg-brand-primary/95 data-scrolled:backdrop-blur-md data-scrolled:border-brand-accent/25 data-scrolled:shadow-[0_4px_20px_rgba(0,0,0,0.15)]"
>
  <div class="container mx-auto flex items-center justify-between px-6">
    <a href="/" class="flex items-center">
      <Image
        src={logoWhiteHorizontal}
        alt={`${contactInfo.businessName} – Home`}
        class="h-12 md:h-14 w-auto transition-all duration-500 group-data-scrolled/header:h-10 md:group-data-scrolled/header:h-11"
      />
    </a>

    <nav aria-label="Main" class="hidden lg:flex items-center gap-8">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={currentPath === link.href ? "page" : undefined}
            class:list={[
              "relative py-1 text-sm font-medium tracking-wide transition-colors duration-300 hover:text-brand-accent",
              "after:absolute after:left-0 after:bottom-0 after:h-px after:w-full after:bg-brand-accent after:origin-left after:scale-x-0 after:transition-transform after:duration-300 hover:after:scale-x-100",
              currentPath === link.href ? "text-brand-accent after:scale-x-100" : "text-white/90",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <Button href="/#contact" variant="light" size="sm">
        Contact Us
      </Button>
    </nav>

    <button
      id="mobile-toggle"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="lg:hidden p-2 rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
    >
      <svg
        id="icon-open"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="text-white transition-colors duration-500"
      >
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
      <svg
        id="icon-close"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="text-white hidden transition-colors duration-500"
      >
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>

  <!-- data-open is toggled by the script below to stagger the links in -->
  <div
    id="mobile-menu"
    class="group/menu lg:hidden overflow-hidden max-h-0 transition-[max-height] duration-500 ease-in-out"
    inert
  >
    <nav aria-label="Mobile" class="flex flex-col items-center pt-6 pb-10">
      <ul class="w-56 divide-y divide-brand-accent/20 text-center">
        {
          navLinks.map((link, i) => (
            <li
              class="opacity-0 translate-y-2 transition-all duration-500 group-data-open/menu:opacity-100 group-data-open/menu:translate-y-0"
              style={`transition-delay: ${100 + i * 80}ms`}
            >
              <a
                href={link.href}
                aria-current={currentPath === link.href ? "page" : undefined}
                class:list={[
                  "block py-4 text-base tracking-widest uppercase font-medium transition-colors",
                  currentPath === link.href
                    ? "text-brand-accent"
                    : "text-white hover:text-brand-accent",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div
        class="mt-6 flex flex-col items-center gap-5 opacity-0 translate-y-2 transition-all duration-500 group-data-open/menu:opacity-100 group-data-open/menu:translate-y-0"
        style={`transition-delay: ${100 + navLinks.length * 80}ms`}
      >
        <Button href="/#contact" variant="light" size="md">
          Contact Us
        </Button>
        <a
          href={`mailto:${contactInfo.email}`}
          class="text-xs tracking-wide text-white/70 hover:text-brand-accent transition-colors"
        >
          {contactInfo.email}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById("site-header") as HTMLElement | null;
    const mobileToggle = document.getElementById("mobile-toggle") as HTMLButtonElement | null;
    const mobileMenu = document.getElementById("mobile-menu") as HTMLElement | null;
    const iconOpen = document.getElementById("icon-open") as HTMLElement | null;
    const iconClose = document.getElementById("icon-close") as HTMLElement | null;

    if (!header || !mobileToggle || !mobileMenu) return;

    let isOpen = false;

    function handleScroll() {
      const isHeaderActive = window.scrollY > 50 || isOpen;
      header?.toggleAttribute("data-scrolled", isHeaderActive);
    }

    const toggleMenu = () => {
      isOpen = !isOpen;
      mobileToggle.setAttribute("aria-expanded", String(isOpen));
      mobileMenu.toggleAttribute("inert", !isOpen);
      mobileMenu.toggleAttribute("data-open", isOpen);
      mobileMenu.style.maxHeight = isOpen ? `${mobileMenu.scrollHeight}px` : "0";
      iconOpen?.classList.toggle("hidden", isOpen);
      iconClose?.classList.toggle("hidden", !isOpen);
      handleScroll();
    };

    // Close menu when any link inside it is clicked (handles hash anchors)
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        if (isOpen) toggleMenu();
      });
    });

    mobileToggle.addEventListener("click", toggleMenu);
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }

  initHeader();
  document.addEventListener("astro:after-swap", initHeader);
</script>
